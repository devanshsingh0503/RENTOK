# ── Database ──────────────────────────────────────────────────
# Get this from Supabase → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── LLM Providers ─────────────────────────────────────────────
# Primary: Groq  →  https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Fallback: Google Gemini  →  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxx

# ── Admin ─────────────────────────────────────────────────────
# A secret token required to call POST /admin/keys  (make up any long random string)
ADMIN_SECRET=supersecret_changeme

# ── Server ────────────────────────────────────────────────────
PORT=3000
